    "Hostnames": [
      "prod.egonet.codemasters.com",
      "egonet.codemasters.com",
      "racenet.codemasters.com",
      "api.racenet.codemasters.com",
      "grid2.racenet.codemasters.com",
      "racenet.com",
      "www.racenet.com",
      "api.racenet.com"
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
