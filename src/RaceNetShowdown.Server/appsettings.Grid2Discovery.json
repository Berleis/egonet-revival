{
  "RaceNet": {
    "GameId": "grid-2",
    "GameName": "GRID 2",
    "DiscoveryMode": true,
    "LogDirectory": "logs/grid-2-discovery",
    "CaptureRequests": true,
    "RecordCalls": false,
    "ListenAnyIp": true,
