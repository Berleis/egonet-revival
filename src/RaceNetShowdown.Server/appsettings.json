{
  "RaceNet": {
    "HttpPort": 80,
    "HttpsPort": 443,
    "ListenAnyIp": false,
    "CertificateDirectory": "certs",
    "LogDirectory": "logs",
    "CaptureRequests": false,
    "RecordCalls": false,
    "StoreProvider": "Local",
    "CertificatePassword": "racenet-local",
    "ServerCertificateCommonName": "prod.egonet.codemasters.com",
    "UseSha1ServerCertificate": false,
    "BodyPreviewBytes": 8192,
    "ChallengePayloadFormat": "BinaryOverviewCapturedSummary",
    "GhostDownloadPayloadFormat": "GhostDataOnly",
    "Hostnames": [
      "prod.egonet.codemasters.com",
      "egonet.codemasters.com",
      "racenet.codemasters.com",
      "api.racenet.codemasters.com",
      "showdown.racenet.codemasters.com",
      "racenet.com",
      "www.racenet.com",
      "api.racenet.com"
    ]
  },
  "ConnectionStrings": {
    "RaceNet": "Server=(localdb)\\MSSQLLocalDB;Database=DirtShowdownRaceNet;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
