{
  "RaceNet": {
    "LogDirectory": "logs",
    "CaptureRequests": true,
    "RecordCalls": false,
    "ListenAnyIp": true,
    "StoreProvider": "Sqlite",
    "ChallengePayloadFormat": "BinaryOverviewCapturedSummary",
    "GhostDownloadPayloadFormat": "GhostDataOnly"
  },
  "ConnectionStrings": {
    "RaceNet": "Data Source=data/egonet-revival.local.db"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
