<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>installer-icon.ico</ApplicationIcon>
    <AssemblyTitle>EgoNet Revival - DiRT 4 Installer</AssemblyTitle>
    <Product>EgoNet Revival</Product>
    <Description>RaceNet restoration installer for DiRT 4</Description>
  </PropertyGroup>
</Project>
